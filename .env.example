# ============================================================
#  Robo de padroes do Double da Blitz
#  Copie para .env e preencha. Nunca comite o .env.
# ============================================================

# ---------- Telegram (obrigatorio) ----------
# Token do bot, dado pelo @BotFather
TELEGRAM_BOT_TOKEN=

# Onde os alertas sao enviados. Pode ser chat privado, grupo ou canal.
# Descubra mandando /id para o bot. Grupo/canal costuma comecar com -100.
TELEGRAM_CHAT_ID=

# Quem pode cadastrar e editar padroes (ids separados por virgula).
# Descubra com /id. Se ficar vazio, QUALQUER pessoa configura: nao recomendado.
TELEGRAM_OWNER_IDS=

# ---------- Fonte dos resultados ----------
# simulator = roleta local, para testar o robo sem depender da Blitz
# blitz     = feed real (exige os enderecos abaixo)
SOURCE=blitz

# Simulador: intervalo entre giros e, opcionalmente, uma sequencia fixa
SIM_INTERVAL_MS=20000
# SIM_SCRIPTED=PPAPAP

# ---------- Feed real da Blitz (CONFIRMADO ao vivo em 2026-10-31) ----------
# Estes valores foram medidos contra blitz4.casino e estao funcionando.
# Para outra plataforma, descubra com:
#   npm run build && node dist/src/probe.js https://<site>/games/double

# WebSocket (caminho principal, atraso medido de ~0,3s)
BLITZ_WS_URL=wss://api-gaming.blitz4.casino/replication/?EIO=4&transport=websocket&binary=1
BLITZ_WS_PROTOCOL=socketio
BLITZ_WS_ROOMS=double_room_1

# REST (usado no backfill ao reconectar e como reserva se o WS cair)
BLITZ_REST_RECENT_URL=https://blitz4.casino/api/singleplayer-originals/originals/roulette_games/recent/1

BLITZ_ORIGIN=https://blitz4.casino
BLITZ_REFERER=https://blitz4.casino/pt/games/double

# Rodada da Blitz dura ~30s, entao 3s de polling fica bem dentro da janela
BLITZ_POLL_MS=3000

# Sem nenhum resultado por este tempo, o coletor reconecta sozinho
BLITZ_STALE_AFTER_MS=100000

# Quantas rodadas buscar no backfill ao (re)conectar
BLITZ_BACKFILL_LIMIT=50

# Mapa de cor CONFIRMADO medindo os rolls ao vivo:
#   color 0 -> roll 0      -> branco
#   color 1 -> rolls 1-7   -> amarelo
#   color 2 -> rolls 8-14  -> preto
BLITZ_COLOR_MAP=0=B,1=A,2=P

# So aceitar rodada com cor definida. Deixe em true.
# O ciclo e waiting (cor nula) -> rolling (cor revelada) -> complete.
BLITZ_REQUIRE_COMPLETE=true

# Nomes de campo alternativos, se a resposta mudar (separe por virgula)
# BLITZ_FIELD_ID=id,game_id
# BLITZ_FIELD_COLOR=color
# BLITZ_FIELD_ROLL=roll
# BLITZ_FIELD_CREATED_AT=created_at
# BLITZ_FIELD_UPDATED_AT=updated_at
# BLITZ_FIELD_STATUS=status

# BLITZ_USER_AGENT=

# ---------- Geral ----------
DB_PATH=data/bot.db
TZ_DISPLAY=America/Sao_Paulo
LOG_LEVEL=info
LOG_FILE=data/bot.log

# Quanto o alerta revela da estrategia:
#   completo (padrao) = mostra nome do padrao e sequencia do gatilho
#   publico           = oculta os dois, para quem revende o sinal
# Depois da primeira troca por /modo no Telegram, vale o que esta no banco.
ALERT_MODE=completo

# --- Painel web ---
# Sem WEB_PASSWORD o painel nem sobe. Escolha uma senha forte: e ela que
# protege o cadastro de padroes.
WEB_PASSWORD=
WEB_PORT=8080
# 127.0.0.1 mantem o painel so no servidor; quem publica e o proxy, com HTTPS.
WEB_HOST=127.0.0.1
# Ligue junto com o HTTPS: marca o cookie de sessao como Secure.
WEB_SECURE_COOKIE=false
