# ============================================================
#  Robo de padroes do Double da Blitz
#  Copie para .env e preencha. Nunca comite o .env.
# ============================================================

# ---------- Telegram (obrigatorio) ----------
# Token do bot, dado pelo @BotFather
TELEGRAM_BOT_TOKEN=

# Onde os alertas sao enviados. Pode ser chat privado, grupo ou canal.
# Descubra mandando /id para o bot. Grupo/canal costuma comecar com -100.
TELEGRAM_CHAT_ID=

# Quem pode cadastrar e editar padroes (ids separados por virgula).
# Descubra com /id. Se ficar vazio, QUALQUER pessoa configura: nao recomendado.
TELEGRAM_OWNER_IDS=

# ---------- Fonte dos resultados ----------
# simulator = roleta local, para testar o robo sem depender da Blitz
# blitz     = feed real (exige os enderecos abaixo)
SOURCE=simulator

# Simulador: intervalo entre giros e, opcionalmente, uma sequencia fixa
SIM_INTERVAL_MS=20000
# SIM_SCRIPTED=PPAPAP

# ---------- Feed real da Blitz ----------
# Descubra os enderecos rodando, de dentro do servidor:
#   npm run build && node dist/src/probe.js https://<site>/games/double
# BLITZ_WS_URL=
# BLITZ_WS_SUBSCRIBE=
# BLITZ_REST_RECENT_URL=
# BLITZ_ORIGIN=https://<site>
# BLITZ_REFERER=https://<site>/games/double

# Intervalo do polling REST, usado quando nao ha WebSocket
BLITZ_POLL_MS=3000

# Sem nenhum resultado por este tempo, o coletor reconecta sozinho
BLITZ_STALE_AFTER_MS=120000

# Quantas rodadas buscar no backfill ao (re)conectar
BLITZ_BACKFILL_LIMIT=50

# Mapa de cor da plataforma -> cor interna (P preto, A amarelo, B branco).
# A familia Blaze usa 0=branco, 1=vermelho/amarelo, 2=preto.
# BLITZ_COLOR_MAP=0=B,1=A,2=P

# So aceitar rodada ja encerrada. Deixe em true: evita agir em round aberto.
BLITZ_REQUIRE_COMPLETE=true

# Nomes de campo alternativos, se a resposta real usar outros (separe por virgula)
# BLITZ_FIELD_ID=id,game_id
# BLITZ_FIELD_COLOR=color
# BLITZ_FIELD_ROLL=roll
# BLITZ_FIELD_CREATED_AT=created_at
# BLITZ_FIELD_STATUS=status

# BLITZ_USER_AGENT=

# ---------- Geral ----------
DB_PATH=data/bot.db
TZ_DISPLAY=America/Sao_Paulo
LOG_LEVEL=info
LOG_FILE=data/bot.log
